{
  "name": "@deepseek-ai/dsh-channel-im",
  "version": "0.3.14",
  "description": "DSH 外部功能一站式插件：钉钉/数字人/Windows 微信个人号通道，含数据库接收、Hook→UIA/OCR 发送、SQLite、AgentAdapter、连接页、技能与预设。",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./self-profile": "./lib/self-profile.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.19.0",
  "files": [
    "auth.mjs",
    "bundle",
    "client",
    "examples",
    "lib",
    "overrides",
    "presets",
    "scripts",
    "skills",
    "tests",
    "wechat_channel",
    "INSTALL.md",
    "README.md",
    "server.mjs"
  ],
  "scripts": {
    "postinstall": "node scripts/install-assets.mjs",
    "test": "node --check lib/index.js && node --check lib/client.js && node --check lib/self-profile.js && node --check server.mjs && node --check scripts/install-assets.mjs && node --test scripts/install-utils.test.mjs tests/self-profile.test.mjs && node scripts/check-compat.mjs && node scripts/run-python-tests.mjs",
    "test:wechat": "node scripts/run-python-tests.mjs",
    "verify:install": "node scripts/verify-overrides.mjs",
    "prepack": "npm test && node scripts/clean-python-cache.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "bundle/dsh-channel-im.cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "dingtalk-stream-sdk-nodejs": "2.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
