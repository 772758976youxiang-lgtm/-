{
  "name": "@deepseek-ai/dsh-channel-im",
  "version": "0.2.2",
  "description": "DSH 外部功能一站式插件：IM 通道桥接（钉钉/企微/微信群聊）+ 数字人扫码 + 「连接」页/「外部打开」 + 技能×2 + 「机器人助手」预设 + Windows 微信网关与接入文档。harness 本体之外的所有扩展，一个插件全包。",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.19.0",
  "files": [
    "auth.mjs",
    "bundle",
    "client",
    "examples",
    "lib",
    "overrides",
    "presets",
    "scripts",
    "skills",
    "INSTALL.md",
    "README.md",
    "server.mjs"
  ],
  "scripts": {
    "postinstall": "node scripts/install-assets.mjs",
    "test": "node --check lib/index.js && node --check lib/client.js && node --check server.mjs && node --check scripts/install-assets.mjs && node --test scripts/install-utils.test.mjs && node scripts/check-compat.mjs",
    "verify:install": "node scripts/verify-overrides.mjs",
    "prepack": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "bundle/dsh-channel-im.cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "dingtalk-stream-sdk-nodejs": "2.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
