+
+void Route_SendAtText(httplib::Server& svr)
+{
+    svr.Post("/SendAtText", [](const httplib::Request& req, httplib::Response& res)
+        {
+            json reqJson;
+            json resp;
+            try
+            {
+                reqJson = json::parse(req.body);
+            }
+            catch (...)
+            {
+                resp["ret"] = -1;
+                resp["retmsg"] = "invalid json";
+                res.set_content(resp.dump(), "application/json");
+                return;
+            }
+
+            const std::string wxidorgid = reqJson.value("wxidorgid", "");
+            const std::string msg = reqJson.value("msg", "");
+            std::string atlist;
+            if (reqJson.contains("atlist") && reqJson["atlist"].is_string())
+            {
+                atlist = reqJson["atlist"].get<std::string>();
+            }
+            else if (reqJson.contains("wxids") && reqJson["wxids"].is_string())
+            {
+                atlist = reqJson["wxids"].get<std::string>();
+            }
+            if (atlist.empty() && reqJson.contains("wxids") && reqJson["wxids"].is_array())
+            {
+                bool first = true;
+                for (const auto& value : reqJson["wxids"])
+                {
+                    if (!value.is_string() || value.get<std::string>().empty()) continue;
+                    if (!first) atlist += ",";
+                    atlist += value.get<std::string>();
+                    first = false;
+                }
+            }
+
+            if (wxidorgid.empty() || msg.empty() || atlist.empty() ||
+                wxidorgid.find("@chatroom") == std::string::npos)
+            {
+                resp["ret"] = -1;
+                resp["retmsg"] = "wxidorgid (group), msg and wxids are required";
+                res.set_content(resp.dump(), "application/json");
+                return;
+            }
+
+            WeixinSend::SendText(wxidorgid, msg, atlist);
+            resp["ret"] = 0;
+            resp["retmsg"] = "success";
+            res.set_content(resp.dump(), "application/json");
+        });
+}
